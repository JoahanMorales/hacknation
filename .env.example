# Por qué: se documentan nombres sin copiar secretos reales.
# Copiar localmente a .env y completar sólo si el producto lo necesita. Por qué: cada producto usa sólo su configuración necesaria.
APP_ENV=demo
PORT=3000
API_BASE_URL=
API_KEY=

# Por qué: los agentes deben tener una identidad estable en claims y bitácoras.
# Exportar estos valores al shell al usar scripts/hack. Por qué: .env no se carga automáticamente.
HACK_AGENT=agent-a
HACK_HUMAN=human-product
