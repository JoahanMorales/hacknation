#!/usr/bin/env bash
# Bash 3.2+; Git y utilidades POSIX. No requiere jq ni Python.
# Por qué: el protocolo funciona en Git Bash, macOS y Linux sin servicios.
set -u
set -o pipefail
LC_ALL=C
export LC_ALL
# Identidad por worktree: .hack-env (creado por scripts/wt, ignorado por Git) sólo rellena variables vacías.
# Por qué: cada terminal o agente del worktree hereda su identidad sin exports manuales.
hack_env_file="$(git rev-parse --show-toplevel 2>/dev/null)/.hack-env"
if [ -f "$hack_env_file" ]; then
  while IFS='=' read -r hack_key hack_value || [ -n "$hack_key" ]; do
    case "$hack_key" in
      HACK_AGENT|HACK_HUMAN|HACK_SESSION|HACK_TASK)
        case "$hack_value" in ''|*[!A-Za-z0-9_.-]*) continue;; esac
        [ -n "$(eval "printf '%s' \"\${$hack_key:-}\"")" ] || export "$hack_key=$hack_value";;
    esac
  done < "$hack_env_file"
fi
LEASE=${HACK_LEASE_SECONDS:-1800}
REMOTE=${HACK_REMOTE:-origin}
BASE=${HACK_BASE:-main}
AGENT=${HACK_AGENT:-}
HUMAN=${HACK_HUMAN:-}
ROOT= TX= TXROOT= NOW=
CMD=${1:-help}
[ "$#" -eq 0 ] || shift
say() { printf '%s\n' "$*"; }
die() { say "ERROR: $*" >&2; exit 2; }
conflict() { say "CONFLICT: $*" >&2; exit 3; }
gitfail() { say "GIT_ERROR: $*" >&2; exit 1; }
valid_id() { printf '%s\n' "$1" | grep -Eq '^HACK-[0-9][0-9][0-9]+$'; }
one_line() { local text=$1; text=${text//$'\r'/ }; text=${text//$'\n'/ }; printf '%s' "$text"; }
field() {
  local line prefix="$2: "
  [ -f "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$prefix"*) printf '%s\n' "${line#"$prefix"}"; return 0;; esac
  done < "$1"
}
clock_now() {
  NOW=${HACK_NOW:-$(date +%s)}
  case "$NOW" in ''|*[!0-9]*) die "HACK_NOW debe ser epoch en segundos.";; esac
  case "$LEASE" in ''|*[!0-9]*|0) die "HACK_LEASE_SECONDS debe ser positivo.";; esac
}
identity() {
  [ -n "$AGENT" ] || AGENT=$HUMAN
  [ -n "$AGENT" ] || die "Defina HACK_AGENT o HACK_HUMAN."
  case "$AGENT" in *[!A-Za-z0-9_.-]*) die "Identidad: use letras, números, punto, guion o guion bajo.";; esac
}
cleanup() {
  # Por qué: solo se elimina el temporal creado por esta invocación.
  if [ -n "$TXROOT" ] && [ -n "${TMP_BASE:-}" ]; then
    case "$TXROOT" in "$TMP_BASE"/hack.??????) rm -rf "$TXROOT";; esac
  fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM
usage() {
  cat <<'USAGE'
hack v2.1 — coordinación en la rama remota claims
status [--task HACK-NNN --summary]
claim ID --branch RAMA --worktree RUTA [--next TEXTO]
heartbeat ID
release ID [--expired --read-summary TOKEN] [--cancel MOTIVO]
log ID [--state CLAIMED|BLOCKED] TEXTO
checkpoint ID|--session --done TEXTO --decision TEXTO --why TEXTO --fails TEXTO --commands TEXTO --next TEXTO
handoff ID
done ID --pr URL --evidence TEXTO [--integrated COMMIT --reviewer OTRO]
digest
tick
next
review ID --sha SHA --verdict approve|reject
register-reviewer NAME  (HACK_HUMAN)
merge ID
decision ID --option TEXTO --why TEXTO --reversible yes|no --authorized yes|no --class routine|money|accounts|publish|scope
secret-exception ID --path RUTA --rule REGLA --reason TEXTO
init-smoke --command COMANDO
lint [--secrets]
HACK_AGENT / HACK_HUMAN · HACK_REMOTE=origin · HACK_BASE=main · lease=1800s
Por qué: el remoto serializa reservas; cada sesión conserva un siguiente paso.
USAGE
}
case "$CMD" in help|-h|--help) usage; exit 0;; esac
case "$CMD" in status|claim|heartbeat|release|log|checkpoint|handoff|done|digest|lint|tick|next|review|register-reviewer|merge|decision|secret-exception|init-smoke) ;; *) die "Comando desconocido: $CMD";; esac
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  case "$CMD" in lint|init-smoke) ;; *) gitfail "Ejecute desde un repositorio Git con remoto.";; esac
  ROOT=$(pwd -P)
}
ROOT=$(cd "$ROOT" && pwd -P) || gitfail "No se puede abrir el repositorio."
BACKLOG="$ROOT/TASKS.md"
OWNERS="$ROOT/OWNERS.md"
source "$ROOT/scripts/hack-coordination"
source "$ROOT/scripts/lib/review-merge.sh"
source "$ROOT/scripts/lib/security.sh"
source "$ROOT/scripts/lib/smoke-init.sh"
# Lee solo una sección; acepta - **Campo:** valor, **Campo**: valor y Campo: valor.
task_field() {
  awk -v id="$ID" -v key="$1" '
    /^## / { on=($2==id) }
    on {
      s=$0; gsub(/\*\*/, "", s); sub(/^[[:space:]]*-[[:space:]]*/, "", s);
      sub(/^[[:space:]]*/, "", s);
      if (index(s,key ":")==1) {
        sub(/^[^:]*:[[:space:]]*/, "", s); print s; exit
      }
    }' "$BACKLOG"
}
load_task() {
  [ -f "$BACKLOG" ] || die "Falta TASKS.md."
  awk -v id="$ID" '/^## / && $2==id {found=1} END {exit !found}' "$BACKLOG" ||
    die "$ID no existe en TASKS.md."
  PRIORITY=$(task_field Prioridad)
  case "$PRIORITY" in P0|P1|P2) ;; *) die "$ID necesita Prioridad P0/P1/P2.";; esac
  PATHS=$(task_field "Archivos probables")
  [ -n "$PATHS" ] || die "$ID necesita Archivos probables."
  DEPENDS=$(task_field "Depende de")
  VERIFY=$(task_field "Cómo verificar")
  [ -n "$VERIFY" ] || die "$ID necesita Cómo verificar."
  DEFAULT_NEXT=$(task_field "Siguiente paso")
  [ -n "$DEFAULT_NEXT" ] || DEFAULT_NEXT="Implementar criterio de $ID y ejecutar: $VERIFY"
  normalize_paths "$PATHS" > "$TXROOT/paths-request" || die "Rutas inválidas en $ID."
}
# Los globs reservan todo su prefijo; un glob de raíz reserva el repositorio.
# Por qué: la sobre-reserva reversible evita conflictos que un glob ocultaría.
normalize_paths() {
  printf '%s\n' "$1" | awk '
    BEGIN {bad=0}
    {
      n=split($0,a,",");
      for(i=1;i<=n;i++) {
        p=a[i]; gsub(sprintf("%c",96),"",p);
        sub(/^[[:space:]]*/,"",p); sub(/[[:space:]]*$/,"",p);
        gsub(/\\/,"/",p); while(p ~ /^\.\//) sub(/^\.\//,"",p);
        gsub(/\/+/,"/",p);
        while(p ~ /\/\.\//) gsub(/\/\.\//,"/",p);
        sub(/\/\.$/,"",p); p=tolower(p);
        if(p=="" || p ~ /^\// || p ~ /^[A-Za-z]:/ || p ~ /(^|\/)\.\.(\/|$)/) {bad=1; continue}
        at=match(p,/[*?\[]/);
        if(at) {
          p=substr(p,1,at-1); sub(/[^\/]*$/,"",p);   # \/ escapado: awk BSD (macOS) corta la regex en / sin escapar
          if(p=="") p=".";
        }
        sub(/\/$/,"",p); if(p=="") p=".";
        print p;
      }
    }
    END {exit bad}' | sort -u
}
overlaps() {
  awk 'NR==FNR {a[++n]=$0;next}
    {for(i=1;i<=n;i++) if(a[i]=="." || $0=="." || a[i]==$0 ||
      index(a[i],$0 "/")==1 || index($0,a[i] "/")==1) exit 1}' "$1" "$2"
  [ "$?" -eq 1 ]
}
owner_rows() {
  [ -f "$OWNERS" ] || return 0
  awk -F'|' '{
    for(i=1;i<NF;i++) {
      p=$i; q=$(i+1); gsub(sprintf("%c",96),"",p); gsub(sprintf("%c",96),"",q);
      sub(/^[[:space:]]*/,"",p);sub(/[[:space:]]*$/,"",p);
      sub(/^[[:space:]]*/,"",q);sub(/[[:space:]]*$/,"",q);
      if(q ~ /^HACK-[0-9][0-9][0-9]+$/) print p "|" q
    }}' "$OWNERS"
}
check_owners() {
  owner_rows > "$TXROOT/owners"
  while IFS='|' read -r pat owner; do
    [ -n "$pat" ] || continue
    normalize_paths "$pat" > "$TXROOT/owner-paths" || die "Patrón OWNERS inválido: $pat"
    if overlaps "$TXROOT/paths-request" "$TXROOT/owner-paths" && [ "$owner" != "$ID" ]; then
      conflict "$pat pertenece a $owner; divida el trabajo o pida su contrato."
    fi
  done < "$TXROOT/owners"
  while IFS= read -r path; do
    case "/$path/" in
      */package-lock.json/*|*/npm-shrinkwrap.json/*|*/pnpm-lock.yaml/*|*/*.lock/*|*/*.lockb/*|*/go.sum/*|*/lockfiles/*|*/migrations/*|*/contracts/*|*/types/*|*/shared-types/*|*/.github/workflows/*|*/.gitlab-ci.yml/*|*/azure-pipelines.yml/*)
        assigned=no
        printf '%s\n' "$path" > "$TXROOT/one-path"
        while IFS='|' read -r pat owner; do
          normalize_paths "$pat" > "$TXROOT/owner-paths" || die "OWNERS inválido."
          if overlaps "$TXROOT/one-path" "$TXROOT/owner-paths" && [ "$owner" = "$ID" ]; then assigned=yes; fi
        done < "$TXROOT/owners"
        [ "$assigned" = yes ] || conflict "Recurso compartido sin dueño en OWNERS.md: $path"
        ;;
    esac
  done < "$TXROOT/paths-request"
}
init_temp() {
  TMP_BASE=$(cd "${TMPDIR:-/tmp}" && pwd -P) || gitfail "No se puede abrir TMPDIR."
  TXROOT=$(mktemp -d "$TMP_BASE/hack.XXXXXX") || gitfail "No se puede crear temporal."
}
remote_setup() {
  REMOTE_URL=$(git -C "$ROOT" config --get "remote.$REMOTE.url") ||
    gitfail "Falta remoto $REMOTE. No se permiten reservas offline."
  case "$REMOTE_URL" in /*|[A-Za-z]:*|*://*|*@*:*) ;; *) REMOTE_URL="$ROOT/$REMOTE_URL";; esac
  USER_NAME=$(git -C "$ROOT" config user.name 2>/dev/null || true)
  USER_EMAIL=$(git -C "$ROOT" config user.email 2>/dev/null || true)
  [ -n "$USER_NAME" ] || USER_NAME=${AGENT:-hack}
  [ -n "$USER_EMAIL" ] || USER_EMAIL=hack@localhost
}
fresh_state() {
  TX="$TXROOT/try-$ATTEMPT"
  mkdir "$TX" || gitfail "No se puede crear transacción."
  git -C "$TX" init -q || gitfail "git init falló."
  git -C "$TX" config user.name "$USER_NAME"
  git -C "$TX" config user.email "$USER_EMAIL"
  git -C "$TX" remote add origin "$REMOTE_URL" || gitfail "Remoto inválido."
  git -C "$TX" ls-remote --heads origin claims > "$TXROOT/refs" 2> "$TXROOT/git-error" ||
    gitfail "Remoto inaccesible. $(head -n 1 "$TXROOT/git-error")"
  if [ -s "$TXROOT/refs" ]; then
    git -C "$TX" fetch -q origin refs/heads/claims || gitfail "fetch claims falló."
    git -C "$TX" checkout -q -b claims FETCH_HEAD || gitfail "checkout claims falló."
    HAS_REMOTE=yes
  else
    git -C "$TX" checkout -q --orphan claims || gitfail "No se puede inicializar claims."
    HAS_REMOTE=no
  fi
  mkdir -p "$TX/tasks" "$TX/claims" "$TX/worklog"
}
is_reserved() { case "$1" in CLAIMED|BLOCKED|REVIEW) return 0;; *) return 1;; esac; }
task_file() { printf '%s/tasks/%s.md\n' "$TX" "$ID"; }
claim_file() { printf '%s/claims/%s.md\n' "$TX" "$ID"; }
require_owner() {
  RECORD=$(task_file); CLAIM=$(claim_file)
  [ -f "$CLAIM" ] && [ -f "$RECORD" ] || conflict "$ID no tiene reserva vigente; no modifique un trabajo ajeno."
  [ "$(field "$CLAIM" Owner)" = "$AGENT" ] || conflict "$ID pertenece a $(field "$CLAIM" Owner)."
  WL=$(field "$RECORD" Worklog)
  valid_worklog "$WL" || die "Ruta de bitácora inválida."
  [ -f "$TX/$WL" ] || die "Falta bitácora $WL."
}
valid_worklog() { printf '%s\n' "$1" | grep -Eq '^worklog/WL-[A-Za-z0-9_.-]+\.md$'; }
put() {
  file=$1 key=$2 value=$(one_line "$3")
  HACK_AWK_VALUE="$value" awk -v key="$key" '
    BEGIN {value=ENVIRON["HACK_AWK_VALUE"]}
    index($0,key ": ")==1 {$0=key ": " value; seen=1} {print}
    END {if(!seen) print key ": " value}' "$file" > "$TXROOT/edit"
  mv "$TXROOT/edit" "$file"
}
summary_text() {
  valid_worklog "$WL" || die "Ruta de bitácora inválida."
  awk '/^## Resumen vivo$/ {on=1;next} /^## Historial$/ {on=0} on && NF {print}' "$TX/$WL"
}
read_token() { { cat "$(claim_file)"; summary_text; } | cksum | awk '{print $1 "-" $2}'; }
set_summary() {
  {
    printf '# %s · %s\n\n## Resumen vivo\n' "$WL" "$ID"
    printf '%s\n' "- Hecho: $(one_line "$DONE_TEXT")" "- Decisión: $(one_line "$DECISION_TEXT")" \
      "- Por qué: $(one_line "$WHY_TEXT")" "- Falla: $(one_line "$FAILS_TEXT")" \
      "- Comandos: $(one_line "$COMMANDS_TEXT")" "- Siguiente: $(one_line "$NEXT_TEXT")"
    printf '\n## Historial\n'
    [ ! -f "$TX/$WL" ] || awk 'on {print} /^## Historial$/ {on=1}' "$TX/$WL"
  } > "$TXROOT/summary"
  mv "$TXROOT/summary" "$TX/$WL"
}
event() { printf '%s\n' "- $NOW | $STATE | $AGENT | $(one_line "$1")" >> "$TX/$WL"; coord_event; }
update_summary_field() {
  label=$1 text=$(one_line "$2")
  HACK_AWK_TEXT="$text" awk -v label="$label" '
    BEGIN {text=ENVIRON["HACK_AWK_TEXT"]}
    /^## Resumen vivo$/ {on=1} /^## Historial$/ {on=0}
    on && index($0,"- " label ": ")==1 {$0="- " label ": " text}
    {print}' "$TX/$WL" > "$TXROOT/summary"
  mv "$TXROOT/summary" "$TX/$WL"
}
refresh_lease() {
  UNTIL=$((NOW + LEASE))
  put "$RECORD" Lease-Until "$UNTIL"; put "$RECORD" Updated "$NOW"
  put "$CLAIM" Lease-Until "$UNTIL"; put "$CLAIM" Updated "$NOW"
}
check_dependencies() {
  deps=$(printf '%s\n' "$DEPENDS" | awk '{
    s=$0; while(match(s,/HACK-[0-9][0-9][0-9]+/)) {
      print substr(s,RSTART,RLENGTH); s=substr(s,RSTART+RLENGTH)
    }}')
  for dep in $deps; do
    [ -f "$TX/tasks/$dep.md" ] && [ "$(field "$TX/tasks/$dep.md" State)" = INTEGRATED ] ||
      conflict "$ID depende de $dep; reclámela tras INTEGRATED."
  done
}
check_collisions() {
  [ ! -f "$(claim_file)" ] || conflict "$ID ya tiene claims/$ID.md; lea su resumen."
  if [ -f "$(task_file)" ]; then
    old_state=$(field "$(task_file)" State)
    case "$old_state" in INTEGRATED|CANCELLED) conflict "$ID ya está $old_state.";; esac
  fi
  check_owners; check_dependencies
  for other in "$TX"/claims/*.md; do
    [ -f "$other" ] || continue
    if [ "$(field "$other" Branch)" = "$BRANCH" ] || [ "$(field "$other" Worktree)" = "$WORKTREE" ]; then
      conflict "Rama/worktree ya reservado por $(field "$other" ID); cree uno por tarea."
    fi
    normalize_paths "$(field "$other" Paths)" > "$TXROOT/other-paths" || die "Claim con Paths inválido."
    if overlaps "$TXROOT/paths-request" "$TXROOT/other-paths"; then
      conflict "$ID se traslapa con $(field "$other" ID) ($(field "$other" Owner)); elija otra tarea."
    fi
  done
}
snapshot() {
  [ -f "$TX/DECISIONS.md" ] || {
    printf '# DECISIONS\n\nDecisiones de coordinación en la rama claims.\nPor qué: una opción reversible a los 15 min permite seguir.\n' > "$TX/DECISIONS.md"
  }
  {
    phase='ejecución'
    freeze=$(coord_config Freeze-Epoch 0)
    if [ "$freeze" -gt 0 ] && [ "$NOW" -ge "$freeze" ]; then phase='feature freeze; sólo fixes autorizados, ensayo y entrega'; fi
    printf '# STATE\n\nFase: %s\nActualizado: %s\n' "$phase" "$NOW"
    for state in AVAILABLE CLAIMED BLOCKED REVIEW INTEGRATED CANCELLED; do
      ids=$(for record in "$TX"/tasks/*.md; do
        [ -f "$record" ] || continue
        [ "$(field "$record" State)" != "$state" ] || field "$record" ID
      done | tr '\n' ' ' | cut -c 1-120)
      if [ "$state" = AVAILABLE ] && [ -f "$BACKLOG" ]; then
        ids=$(awk '/^## HACK-[0-9]/ {print $2}' "$BACKLOG" | while IFS= read -r id; do
          [ -f "$TX/tasks/$id.md" ] || printf '%s ' "$id"
        done; printf '%s' "$ids")
        ids=$(printf '%s' "$ids" | cut -c 1-120)
      fi
      printf '%s: %s\n' "$state" "${ids:--}"
    done
    printf '\nReservas (primeras 24; status --task ID muestra detalle):\n'
    for c in "$TX"/claims/*.md; do
      [ -f "$c" ] || continue
      printf '%s | %s | %s | hasta %s\n' "$(field "$c" ID)" "$(field "$c" State)" "$(field "$c" Owner)" "$(field "$c" Lease-Until)"
    done | head -n 24
    printf '\nBloqueos: tareas BLOCKED; use status --task ID --summary.\nDecisiones vigentes (últimas 5):\n'
    grep '^-' "$TX/DECISIONS.md" | tail -n 5 | cut -c 1-180
    printf '\nSiguiente paso global: P0 disponible; si no, revisar PR, tests, demo y ensayo.\nPor qué: snapshot acotado para retomar sin releer el historial.\n'
  } > "$TX/STATE.md"
}
mutate() {
  coord_init
  RECORD=$(task_file); CLAIM=$(claim_file)
  case "$CMD" in
    claim)
      coord_tick_mutate; load_task
      [ -n "$REQUEST_NEXT" ] || NEXT_TEXT=$DEFAULT_NEXT
      coord_claim_gate
      check_collisions; STATE=CLAIMED; UNTIL=$((NOW + LEASE))
      WL="worklog/WL-$NOW-$AGENT-$ID-$(basename "$TXROOT").md"
      task_base=$CLAIM_BASE
      if [ -f "$RECORD" ]; then
        prior_wl=$(field "$RECORD" Worklog)
        if [ -f "$TX/$prior_wl" ]; then
          WL=$prior_wl
          task_base=$(field "$RECORD" Task-Base)
          [ -n "$REQUEST_NEXT" ] || NEXT_TEXT=$(field "$RECORD" Next)
        fi
      fi
      {
        printf '# %s\n' "$ID"
        printf '%s\n' "ID: $ID" "State: $STATE" "Owner: $AGENT" "Branch: $BRANCH" "Worktree: $WORKTREE" \
          "Worklog: $WL" "Priority: $PRIORITY" "Paths: $(one_line "$PATHS")" \
          "Depends: $(one_line "$DEPENDS")" "Verify: $(one_line "$VERIFY")" \
          "Lease-Until: $UNTIL" "Updated: $NOW" "Task-Base: $task_base" "Next: $(one_line "$NEXT_TEXT")" "PR: -" "Evidence: -"
      } > "$RECORD"
      cp "$RECORD" "$CLAIM"
      DONE_TEXT="Reserva creada; implementación pendiente"
      DECISION_TEXT="Rama y worktree independientes"
      WHY_TEXT="Permiten trabajar en paralelo sin alterar el checkout principal"
      FAILS_TEXT="Ninguna validación ejecutada todavía"; COMMANDS_TEXT=$VERIFY
      if [ -f "$TX/$WL" ]; then update_summary_field Siguiente "$NEXT_TEXT"; else set_summary; fi
      event "claim; siguiente: $NEXT_TEXT"
      ;;
    heartbeat)
      coord_tick_mutate
      require_owner; STATE=$(field "$RECORD" State)
      refresh_lease; event "heartbeat; lease hasta $UNTIL"
      ;;
    release)
      [ -f "$CLAIM" ] && [ -f "$RECORD" ] || conflict "$ID no tiene claim."
      WL=$(field "$RECORD" Worklog); STATE=$(field "$RECORD" State)
      valid_worklog "$WL" || die "Ruta de bitácora inválida."
      [ -f "$TX/$WL" ] || die "Falta Resumen vivo."
      if [ "$(field "$CLAIM" Owner)" != "$AGENT" ]; then
        [ "$EXPIRED" = yes ] || conflict "Solo el dueño puede liberar un claim no vencido."
        until=$(field "$CLAIM" Lease-Until)
        case "$until" in ''|*[!0-9]*) die "Lease inválido.";; esac
        [ "$NOW" -ge "$until" ] || conflict "Lease de $ID todavía vigente."
        [ -n "$TOKEN" ] && [ "$TOKEN" = "$(read_token)" ] ||
          conflict "Lea status --task $ID --summary y use su Read-token actual."
      fi
      STATE=AVAILABLE
      if [ -n "$CANCEL_REASON" ]; then
        [ "$(field "$CLAIM" Owner)" = "$AGENT" ] || conflict "Solo el dueño puede cancelar."
        STATE=CANCELLED
        put "$RECORD" Next "Cancelada: $CANCEL_REASON"
        update_summary_field Siguiente "Cancelada: $CANCEL_REASON"
      fi
      put "$RECORD" State "$STATE"; put "$RECORD" Updated "$NOW"; put "$RECORD" Lease-Until 0
      rm "$CLAIM"; event "release; reserva liberada por $AGENT; motivo: ${CANCEL_REASON:--}; resumen conservado"
      ;;
    log)
      require_owner; STATE=$(field "$RECORD" State)
      if [ -n "$NEW_STATE" ]; then
        case "$STATE" in CLAIMED|BLOCKED) ;; *) conflict "log no puede sacar $ID de $STATE.";; esac
        STATE=$NEW_STATE; put "$RECORD" State "$STATE"; put "$CLAIM" State "$STATE"
      fi
      [ "$STATE" != BLOCKED ] || update_summary_field Falla "$LOG_TEXT"
      refresh_lease; event "$LOG_TEXT"
      ;;
    checkpoint)
      if [ "$SESSION_ONLY" = yes ]; then coord_checkpoint_session
      else
        if [ -f "$CLAIM" ]; then require_owner
        else
          [ -f "$RECORD" ] && [ "$(field "$RECORD" Owner)" = "$AGENT" ] || conflict "Checkpoint exige registro propio o --session."
          WL=$(field "$RECORD" Worklog); valid_worklog "$WL" && [ -f "$TX/$WL" ] || die "Falta bitácora válida."
        fi
        STATE=$(field "$RECORD" State); set_summary
        put "$RECORD" Next "$NEXT_TEXT"
        if [ -f "$CLAIM" ]; then put "$CLAIM" Next "$NEXT_TEXT"; refresh_lease
        else put "$RECORD" Updated "$NOW"; fi
        if [ "$DECISION_TEXT" != "-" ] && [ -n "$DECISION_TEXT" ]; then
          [ -f "$TX/DECISIONS.md" ] || printf '# DECISIONS\n' > "$TX/DECISIONS.md"
          printf '%s\n' "- $NOW | $ID | $(one_line "$DECISION_TEXT") | Por qué: $(one_line "$WHY_TEXT")" >> "$TX/DECISIONS.md"
        fi
        event "checkpoint; siguiente: $NEXT_TEXT"
      fi
      ;;
    handoff)
      if [ -f "$CLAIM" ]; then require_owner; refresh_lease
      else
        [ -f "$RECORD" ] && [ "$(field "$RECORD" Owner)" = "$AGENT" ] || conflict "Sólo el dueño puede cerrar handoff."
        WL=$(field "$RECORD" Worklog)
      fi
      STATE=$(field "$RECORD" State); event "handoff; siguiente: $(field "$RECORD" Next)"
      ;;
    tick) coord_tick_mutate;;
    review) review_mutate;;
    register-reviewer) register_reviewer_mutate;;
    decision) coord_decision_mutate;;
    secret-exception) secret_exception_action;;
    done)
      require_owner; STATE=REVIEW
      task_branch=$(field "$RECORD" Branch)
      task_worktree=$(field "$RECORD" Worktree)
      tip=$(field "$RECORD" Task-Tip)
      if [ -z "$MERGE_COMMIT" ]; then
        tip=$(git -C "$task_worktree" rev-parse HEAD 2>/dev/null) || die "Falta worktree para registrar Task-Tip."
      else
        git check-ref-format "refs/heads/$BASE" >/dev/null 2>&1 || die "HACK_BASE inválida."
        git -C "$TX" fetch -q origin "refs/heads/$BASE:refs/hack/base" ||
          gitfail "No se pudo verificar la rama base remota $BASE."
        resolve_task_tip || conflict "$RM_REASON"
        tip=$RM_TIP
        [ -n "$tip" ] || conflict "Falta Task-Tip; registre primero done REVIEW o publique rama."
        task_base=$(field "$RECORD" Task-Base)
        [ -n "$task_base" ] && [ "$tip" != "$task_base" ] ||
          conflict "TIP coincide con la base de la reserva; falta implementación."
        merged=$(git -C "$TX" rev-parse --verify "$MERGE_COMMIT^{commit}" 2>/dev/null) ||
          conflict "COMMIT no disponible en la historia remota de $BASE."
        approval_check "$tip" "$PR_URL" || conflict "$RM_REASON"
        [ -z "$REVIEWER" ] || [ "$REVIEWER" = "$APPROVED_BY" ] || conflict "--reviewer no coincide con la aprobación verificada."
        integrated_check "$tip" "$merged" || conflict "$RM_REASON"
        REVIEWER=$APPROVED_BY
        put "$RECORD" Integration-Proof "$RM_PROOF"
        STATE=INTEGRATED
        put "$RECORD" Merge-Commit "$merged"; put "$RECORD" Reviewer "$REVIEWER"
      fi
      put "$RECORD" Task-Tip "$tip"
      put "$RECORD" State "$STATE"; put "$CLAIM" State "$STATE"
      put "$RECORD" PR "$PR_URL"; put "$CLAIM" PR "$PR_URL"; put "$RECORD" Evidence "$EVIDENCE"
      put "$RECORD" Next "Revisor distinto evalúa $PR_URL; ejecutar scripts/smoke"
      put "$CLAIM" Next "Revisor distinto evalúa $PR_URL; ejecutar scripts/smoke"
      update_summary_field Hecho "$EVIDENCE"
      update_summary_field Siguiente "Revisor distinto evalúa $PR_URL; ejecutar scripts/smoke"
      if [ "$STATE" = INTEGRATED ]; then
        put "$RECORD" Next "Integrada en $BASE: $merged; reclamar siguiente P0"
        put "$RECORD" Lease-Until 0; put "$RECORD" Updated "$NOW"
        update_summary_field Siguiente "Integrada en $BASE: $merged; reclamar siguiente P0"
        rm "$CLAIM"
      else refresh_lease; fi
      event "done; PR $PR_URL; evidencia: $EVIDENCE; reviewer: ${REVIEWER:--}"
      ;;
  esac
  # Una lectura idempotente no cambia STATE ni genera un commit vacío.
  if [ -n "$(git -C "$TX" status --porcelain)" ]; then snapshot; fi
}
transaction() {
  ATTEMPT=0
  while :; do
    ATTEMPT=$((ATTEMPT + 1)); fresh_state; mutate
    git -C "$TX" add -A || gitfail "git add falló."
    git -C "$TX" diff --cached --quiet && return 0
    git -C "$TX" commit -q -m "hack: $CMD $ID ($AGENT)" || gitfail "git commit falló."
    if git -C "$TX" push --porcelain origin HEAD:refs/heads/claims > "$TXROOT/push" 2>&1; then
      if [ "${QUIET:-no}" != yes ]; then
        if [ "$SESSION_ONLY" = yes ]; then say "OK checkpoint --session | presupuesto reiniciado | intento $ATTEMPT"
        elif [ "$CMD" = tick ]; then say "OK tick | plazos reconciliados | intento $ATTEMPT"
        else say "OK $CMD $ID | $(field "$RECORD" State) | intento $ATTEMPT"; fi
      fi
      if [ "$CMD" = handoff ]; then print_task; fi
      return 0
    fi
    if grep -Eqi 'pre-receive hook declined|hook declined|protected branch|permission denied|authentication failed|remote rejected.*(policy|prohibited)' "$TXROOT/push" ||
       ! grep -Eqi 'fetch first|non-fast-forward|cannot lock ref|already exists|failed to update ref|incorrect old value provided' "$TXROOT/push"; then
      gitfail "push falló; la reserva no se confirmó. $(tail -n 2 "$TXROOT/push")"
    fi
    # Por qué: otro push válido obliga a incorporar y revalidar, no a abandonar.
    [ "${QUIET:-no}" = yes ] || say "RETRY $CMD $ID | contención remota; fetch, rebase y revalidación" >&2
    previous_tip=$(git -C "$TX" rev-parse HEAD^ 2>/dev/null || true)
    git -C "$TX" fetch -q origin refs/heads/claims || gitfail "fetch tras push rechazado falló."
    remote_tip=$(git -C "$TX" rev-parse FETCH_HEAD)
    [ "$remote_tip" != "$previous_tip" ] || gitfail "push rechazado sin avance remoto; revise permisos/protección."
    if ! git -C "$TX" rebase FETCH_HEAD > "$TXROOT/rebase" 2>&1; then
      git -C "$TX" rebase --abort > /dev/null 2>&1 || true
    fi
    # Rehacer desde el nuevo remoto revalida IDs, leases y solapamientos incluso
    # si el rebase textual fue limpio. Nunca se publica una validación obsoleta.
  done
}
print_task() {
  RECORD=$(task_file)
  if [ -f "$RECORD" ]; then
    WL=$(field "$RECORD" Worklog)
    say "$ID | $(field "$RECORD" State) | $(field "$RECORD" Owner)"
    say "Branch: $(field "$RECORD" Branch)"
    say "Worktree: $(field "$RECORD" Worktree)"
    say "Next: $(field "$RECORD" Next)"
    say "Worklog: $WL (rama claims)"
    if [ "$SHOW_SUMMARY" = yes ] || [ "$CMD" = handoff ]; then
      say "Resumen vivo:"; summary_text
      [ ! -f "$(claim_file)" ] || say "Read-token: $(read_token)"
    fi
    [ "$CMD" != handoff ] || coord_handoff
  else
    load_task; say "$ID | AVAILABLE | $PRIORITY"; say "Next: $DEFAULT_NEXT"; say "Verify: $VERIFY"
  fi
}
print_status() {
  [ -z "$ID" ] || { print_task; coord_status_budget; say "$CLOCK_NOTE"; return; }
  say "hack v2.1 | claims remoto | epoch $NOW | lease ${LEASE}s"
  for state in AVAILABLE CLAIMED BLOCKED REVIEW INTEGRATED CANCELLED; do
    count=0
    for f in "$TX"/tasks/*.md; do
      [ -f "$f" ] || continue
      [ "$(field "$f" State)" != "$state" ] || count=$((count + 1))
    done
    if [ "$state" = AVAILABLE ] && [ -f "$BACKLOG" ]; then
      extra=$(awk '/^## HACK-[0-9]/ {print $2}' "$BACKLOG" | while IFS= read -r id; do
        [ -f "$TX/tasks/$id.md" ] || say "$id"
      done | awk 'END {print NR+0}')
      count=$((count + extra))
    fi
    printf '%s=%s ' "$state" "$count"
  done
  printf '\n'; say "Reservas (máx. 12; use --task ID):"
  for f in "$TX"/claims/*.md; do
    [ -f "$f" ] || continue
    until=$(field "$f" Lease-Until); expiry=vigente
    [ "$NOW" -lt "$until" ] || expiry=VENCIDA
    say "$(field "$f" ID) | $(field "$f" State) | $(field "$f" Owner) | $expiry | hasta $until"
  done | head -n 12
  scope=$(sed -n 's/^# HACK_SMOKE_SCOPE: //p' "$ROOT/scripts/smoke" 2>/dev/null | head -n 1)
  say "Smoke: ${scope:-alcance no declarado; revise scripts/smoke}"
  say "Siguiente: ejecute hack next."
  coord_status_budget; say "$CLOCK_NOTE"
}
print_digest() {
  say "Digest humano | epoch $NOW | claims remoto"; found=no
  for f in "$TX"/tasks/*.md; do
    [ -f "$f" ] || continue
    state=$(field "$f" State)
    case "$state" in REVIEW|BLOCKED)
      found=yes
      say "$(field "$f" ID) | $state | $(field "$f" Owner) | PR $(field "$f" PR)"
      say "  $(field "$f" Next)"
      ;;
    esac
  done
  [ "$found" = yes ] || say "Sin revisión ni bloqueos pendientes."
  [ ! -f "$TX/DECISIONS.md" ] || grep '^-' "$TX/DECISIONS.md" | tail -n 5
  say "Regla: sin respuesta 15 min, decisión reversible registrada y otra tarea."
}
budget() {
  [ -f "$1" ] || { say "LINT: falta $1" >&2; LINT_ERRORS=$((LINT_ERRORS + 1)); return; }
  lines=$(awk 'END {print NR+0}' "$1"); words=$(awk '{n+=NF} END {print n+0}' "$1")
  say "BUDGET $(basename "$1"): $lines líneas / $words palabras (máx. $2 / $3)"
  if [ "$lines" -gt "$2" ] || [ "$words" -gt "$3" ]; then LINT_ERRORS=$((LINT_ERRORS + 1)); fi
}
lint_all() {
  LINT_ERRORS=0; budget "$ROOT/AGENTS.md" 150 1800
  state_file="$TX/STATE.md"; [ -f "$state_file" ] || state_file="$ROOT/STATE.md"
  [ -f "$state_file" ] || state_file="$ROOT/STATE.template.md"
  budget "$state_file" 60 700
  pr_template="$ROOT/.github/pull_request_template.md"
  if [ ! -f "$pr_template" ] || [ "$(awk 'END {print NR+0}' "$pr_template")" -ne 5 ]; then
    say "LINT: plantilla de PR debe tener 5 líneas" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
  fi
  for w in "$TX"/worklog/*.md; do
    [ -f "$w" ] || continue
    summary_lines=$(awk '/^## Resumen vivo$/ {on=1;next} /^## Historial$/ {on=0} on {n++} END {print n+0}' "$w")
    if [ "$summary_lines" -gt 15 ] || [ "$(grep -c '^## Resumen vivo$' "$w")" -ne 1 ] ||
       [ "$(grep -c '^## Historial$' "$w")" -ne 1 ]; then
      say "LINT: Resumen vivo inválido: $(basename "$w")" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
    if ! awk '/^## Historial$/ {on=1;next} on && NF && $0 !~ /^- [0-9]+ \| (AVAILABLE|CLAIMED|BLOCKED|REVIEW|INTEGRATED|CANCELLED) \| / {bad=1} END {exit bad}' "$w"; then
      say "LINT: historial debe tener una línea por evento: $(basename "$w")" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
    rel="worklog/$(basename "$w")"
    if git -C "$TX" show "HEAD^:$rel" > "$TXROOT/previous" 2>/dev/null; then
      awk '/^## Historial$/ {on=1;next} on {print}' "$TXROOT/previous" > "$TXROOT/history-old"
      awk '/^## Historial$/ {on=1;next} on {print}' "$w" > "$TXROOT/history-new"
      n=$(awk 'END {print NR+0}' "$TXROOT/history-old")
      head -n "$n" "$TXROOT/history-new" > "$TXROOT/history-prefix"
      if ! cmp -s "$TXROOT/history-old" "$TXROOT/history-prefix"; then
        say "LINT: historial modificado, debe ser append-only: $rel" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
      fi
    fi
  done
  for f in "$TX"/tasks/*.md; do
    [ -f "$f" ] || continue
    state=$(field "$f" State); id=$(field "$f" ID)
    case "$state" in AVAILABLE|CLAIMED|BLOCKED|REVIEW|INTEGRATED|CANCELLED) ;; *)
      say "LINT: estado inválido en $id" >&2; LINT_ERRORS=$((LINT_ERRORS + 1));; esac
    reserved=no; is_reserved "$state" && reserved=yes
    if { [ "$reserved" = yes ] && [ ! -f "$TX/claims/$id.md" ]; } ||
       { [ "$reserved" = no ] && [ -f "$TX/claims/$id.md" ]; }; then
      say "LINT: estado y claim inconsistentes en $id" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
    wl=$(field "$f" Worklog)
    if ! valid_worklog "$wl" || [ ! -f "$TX/$wl" ]; then
      say "LINT: falta bitácora válida $id" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
  done
  for f in "$TX"/claims/*.md; do
    [ -f "$f" ] || continue
    id=$(field "$f" ID)
    [ -f "$TX/tasks/$id.md" ] || { say "LINT: claim huérfano $id" >&2; LINT_ERRORS=$((LINT_ERRORS + 1)); }
    if [ -f "$TX/tasks/$id.md" ]; then
      for key in State Owner Branch Worktree Lease-Until Worklog; do
        if [ "$(field "$f" "$key")" != "$(field "$TX/tasks/$id.md" "$key")" ]; then
          say "LINT: claim y tarea difieren en $id/$key" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
        fi
      done
    fi
  done
  owner_rows > "$TXROOT/owners"
  while IFS='|' read -r pat owner; do
    [ -n "$owner" ] || continue
    if ! awk -v id="$owner" '/^## / && $2==id {found=1} END {exit !found}' "$BACKLOG"; then
      say "LINT: dueño no existe en TASKS: $owner" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
  done < "$TXROOT/owners"
  if [ "$LINT_SECRETS" = yes ]; then secrets_lint || LINT_ERRORS=$((LINT_ERRORS + 1)); fi
  [ "$LINT_ERRORS" -eq 0 ] || { say "LINT_FAILED $LINT_ERRORS"; return 1; }
  say "LINT_OK"
}
ID= BRANCH= WORKTREE= NEXT_TEXT= REQUEST_NEXT= TOKEN= NEW_STATE= LOG_TEXT= PR_URL= EVIDENCE=
MERGE_COMMIT= REVIEWER= CANCEL_REASON=
EXPIRED=no SHOW_SUMMARY=no LINT_SECRETS=no QUIET=no SESSION_ONLY=no
REVIEW_SHA= REVIEW_VERDICT= REGISTER_REVIEWER= SMOKE_COMMAND= SECRET_PATH= SECRET_RULE= SECRET_REASON=
DECISION_OPTION= DECISION_REVERSIBLE=no DECISION_AUTHORIZED=no DECISION_CLASS=routine
DONE_TEXT= DECISION_TEXT= WHY_TEXT= FAILS_TEXT= COMMANDS_TEXT=
case "$CMD" in
  status|digest|lint|tick|init-smoke) ;;
  next) identity;;
  checkpoint)
    [ "$#" -gt 0 ] || die "Falta ID o --session."
    if [ "$1" = --session ]; then SESSION_ONLY=yes; shift
    else ID=$1; shift; valid_id "$ID" || die "ID inválido."; fi
    identity;;
  register-reviewer)
    [ "$#" -gt 0 ] || die "Falta NAME."; REGISTER_REVIEWER=$1; ID=$1; shift; identity;;
  *) [ "$#" -gt 0 ] || die "Falta ID."
     ID=$1; shift; valid_id "$ID" || die "ID inválido."; identity;;
esac
while [ "$#" -gt 0 ]; do
  opt=$1; shift
    case "$opt" in
    --secrets) [ "$CMD" = lint ] || die "Opción inválida: $opt"; LINT_SECRETS=yes;;
    --expired) [ "$CMD" = release ] || die "Opción inválida: $opt"; EXPIRED=yes;;
    --summary) [ "$CMD" = status ] || die "Opción inválida: $opt"; SHOW_SUMMARY=yes;;
    --task|--branch|--worktree|--next|--read-summary|--state|--done|--decision|--why|--fails|--commands|--pr|--evidence|--integrated|--reviewer|--cancel|--sha|--verdict|--command|--option|--reversible|--authorized|--class|--path|--rule|--reason)
      [ "$#" -gt 0 ] || die "Falta valor para $opt."
      value=$1; shift
      case "$opt" in
        --task) [ "$CMD" = status ] || die "Opción inválida."; ID=$value; valid_id "$ID" || die "ID inválido.";;
        --branch) [ "$CMD" = claim ] || die "Opción inválida."; BRANCH=$value;;
        --worktree) [ "$CMD" = claim ] || die "Opción inválida."; WORKTREE=$value;;
        --next) case "$CMD" in claim|checkpoint) NEXT_TEXT=$value;; *) die "Opción inválida.";; esac;;
        --read-summary) [ "$CMD" = release ] || die "Opción inválida."; TOKEN=$value;;
        --state) [ "$CMD" = log ] || die "Opción inválida."; NEW_STATE=$value; case "$value" in CLAIMED|BLOCKED) ;; *) die "Estado inválido.";; esac;;
        --done) [ "$CMD" = checkpoint ] || die "Opción inválida."; DONE_TEXT=$value;;
        --decision) [ "$CMD" = checkpoint ] || die "Opción inválida."; DECISION_TEXT=$value;;
        --why) case "$CMD" in checkpoint|decision) ;; *) die "Opción inválida.";; esac; WHY_TEXT=$value;;
        --fails) [ "$CMD" = checkpoint ] || die "Opción inválida."; FAILS_TEXT=$value;;
        --commands) [ "$CMD" = checkpoint ] || die "Opción inválida."; COMMANDS_TEXT=$value;;
        --pr) [ "$CMD" = done ] || die "Opción inválida."; PR_URL=$value;;
        --evidence) [ "$CMD" = done ] || die "Opción inválida."; EVIDENCE=$value;;
        --integrated) [ "$CMD" = done ] || die "Opción inválida."; MERGE_COMMIT=$value;;
        --reviewer) [ "$CMD" = done ] || die "Opción inválida."; REVIEWER=$value;;
        --sha) [ "$CMD" = review ] || die "Opción inválida."; REVIEW_SHA=$value;;
        --verdict) [ "$CMD" = review ] || die "Opción inválida."; REVIEW_VERDICT=$value;;
        --command) [ "$CMD" = init-smoke ] || die "Opción inválida."; SMOKE_COMMAND=$value;;
        --option) [ "$CMD" = decision ] || die "Opción inválida."; DECISION_OPTION=$value;;
        --reversible) [ "$CMD" = decision ] || die "Opción inválida."; DECISION_REVERSIBLE=$value;;
        --authorized) [ "$CMD" = decision ] || die "Opción inválida."; DECISION_AUTHORIZED=$value;;
        --class) [ "$CMD" = decision ] || die "Opción inválida."; DECISION_CLASS=$value;;
        --path) [ "$CMD" = secret-exception ] || die "Opción inválida."; SECRET_PATH=$value;;
        --rule) [ "$CMD" = secret-exception ] || die "Opción inválida."; SECRET_RULE=$value;;
        --reason) [ "$CMD" = secret-exception ] || die "Opción inválida."; SECRET_REASON=$value;;
        --cancel) [ "$CMD" = release ] || die "Opción inválida."; CANCEL_REASON=$value;;
      esac
      ;;
    *) [ "$CMD" = log ] || die "Argumento inesperado: $opt"
       LOG_TEXT="$LOG_TEXT${LOG_TEXT:+ }$opt";;
  esac
done
[ "$SHOW_SUMMARY" = no ] || [ -n "$ID" ] || die "--summary requiere --task ID."
if [ -n "$AGENT" ] || [ -n "$HUMAN" ]; then identity; fi
clock_now; init_temp
if [ "$CMD" = init-smoke ]; then init_smoke; exit "$?"; fi
if [ "$CMD" = claim ]; then
  [ -n "$BRANCH" ] && [ -n "$WORKTREE" ] || die "claim requiere --branch y --worktree."
  git check-ref-format --branch "$BRANCH" > /dev/null 2>&1 || die "Rama inválida."
  WORKTREE=$(cd "$WORKTREE" 2>/dev/null && pwd -P) || die "Worktree inexistente."
  primary=$(git -C "$ROOT" worktree list --porcelain | sed -n 's/^worktree //p' | head -n 1)
  primary=$(cd "$primary" && pwd -P) || die "Checkout principal inválido."
  [ "$WORKTREE" != "$primary" ] || die "Use un worktree separado del checkout principal."
  registered_root=$(git -C "$WORKTREE" rev-parse --show-toplevel 2>/dev/null) || die "Worktree inválido."
  registered_root=$(cd "$registered_root" && pwd -P) || die "Worktree inválido."
  [ "$WORKTREE" = "$registered_root" ] || die "Use la raíz exacta de un worktree registrado."
  actual=$(git -C "$WORKTREE" symbolic-ref --short HEAD 2>/dev/null) || die "Worktree detached o inválido."
  [ "$actual" = "$BRANCH" ] || die "Worktree no está en $BRANCH."
  CLAIM_BASE=$(git -C "$WORKTREE" rev-parse HEAD) || die "Falta commit inicial en worktree."
  common_main=$(git -C "$ROOT" rev-parse --git-common-dir)
  common_work=$(git -C "$WORKTREE" rev-parse --git-common-dir)
  common_main=$(cd "$ROOT" && cd "$common_main" && pwd -P) || die "Git common dir inválido."
  common_work=$(cd "$WORKTREE" && cd "$common_work" && pwd -P) || die "Git common dir inválido."
  [ "$common_main" = "$common_work" ] || die "Worktree pertenece a otro repositorio."
  REQUEST_NEXT=$NEXT_TEXT
fi
if [ "$CMD" = checkpoint ]; then
  [ -n "$DONE_TEXT" ] && [ -n "$DECISION_TEXT" ] && [ -n "$WHY_TEXT" ] &&
    [ -n "$FAILS_TEXT" ] && [ -n "$COMMANDS_TEXT" ] && [ -n "$NEXT_TEXT" ] ||
    die "checkpoint necesita los seis campos; use - para ninguno."
fi
if [ "$CMD" = done ]; then
  case "$PR_URL" in https://*/*) ;; *) die "done requiere --pr URL HTTPS.";; esac
  [ -n "$EVIDENCE" ] || die "done requiere --evidence."
  if [ -n "$REVIEWER" ]; then
    case "$REVIEWER" in *[!A-Za-z0-9_.-]*) die "Reviewer debe ser una identidad válida.";; esac
  fi
fi
[ "$CMD" != log ] || [ -n "$LOG_TEXT" ] || die "log necesita una entrada."
if [ "$CMD" = lint ] && ! git -C "$ROOT" config --get "remote.$REMOTE.url" >/dev/null 2>&1; then
  TX="$TXROOT/local"; mkdir -p "$TX/worklog" "$TX/tasks" "$TX/claims"; lint_all; exit "$?"
fi
# La pérdida del remoto es un modo de lectura explícito; ninguna escritura offline.
case "$CMD" in status|next)
  if ! git -C "$ROOT" ls-remote --heads "$REMOTE" >/dev/null 2>&1; then coord_degraded_status; exit 0; fi;;
esac
remote_setup
case "$CMD" in
  status|next)
    saved_cmd=$CMD saved_id=$ID; CMD=tick; ID=; QUIET=yes
    transaction
    CMD=$saved_cmd; ID=$saved_id; QUIET=no
    coord_clock
    case "$CMD" in status) print_status;; next) coord_next;; esac;;
  digest|lint)
    ATTEMPT=1; fresh_state
    case "$CMD" in digest) print_digest;; lint) lint_all; exit "$?";; esac;;
  merge) merge_run; exit "$?";;
  *) [ "$CMD" != tick ] || AGENT=${AGENT:-scheduler}; transaction;;
esac
