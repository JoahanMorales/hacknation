#!/usr/bin/env bash
# Arranque de tarea en un comando: rama + worktree + identidad (.hack-env) + claim. Bash 3.2+.
# Por qué: el ritual manual (4 comandos con flags) es el error más común al iniciar una sesión.
set -u
set -o pipefail
REMOTE=${HACK_REMOTE:-origin}
BASE=${HACK_BASE:-main}
say() { printf '%s\n' "$*"; }
die() { say "WT_ERROR: $*" >&2; exit 2; }
usage() {
  cat <<'USAGE'
wt new HACK-NNN [--agent NOMBRE] [--human NOMBRE] [--next TEXTO]   crea rama/worktree, escribe .hack-env y reclama
wt session                                                          rota HACK_SESSION del worktree actual (nueva sesión)
wt rm HACK-NNN                                                      quita tu worktree (sin --force; conserva la rama)
wt ls                                                               lista worktrees
USAGE
}
clean_id() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_.-]+$'; }
main_root() { git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p'; }
wt_path() { printf '%s/%s-wt/%s' "$(dirname "$1")" "$(basename "$1")" "$(printf '%s' "$2" | tr 'A-Z' 'a-z')"; }
write_env() {
  # $1 dir, $2 agent, $3 human, $4 task
  local session
  session="$2-$(date +%s)"
  printf 'HACK_AGENT=%s\nHACK_HUMAN=%s\nHACK_SESSION=%s\nHACK_TASK=%s\n' "$2" "$3" "$session" "$4" > "$1/.hack-env"
  # Claude Code aplica este env a cada comando Bash del agente en este worktree.
  mkdir -p "$1/.claude"
  printf '{\n  "env": {\n    "HACK_AGENT": "%s",\n    "HACK_HUMAN": "%s",\n    "HACK_SESSION": "%s",\n    "HACK_TASK": "%s"\n  }\n}\n' \
    "$2" "$3" "$session" "$4" > "$1/.claude/settings.local.json"
}
cmd=${1:-help}; [ "$#" -eq 0 ] || shift
case "$cmd" in
  help|-h|--help) usage; exit 0;;
  ls) git worktree list; exit $?;;
  session)
    top=$(git rev-parse --show-toplevel 2>/dev/null) || die "Ejecuta dentro de un worktree."
    [ -f "$top/.hack-env" ] || die "Este worktree no tiene .hack-env; usa wt new."
    agent=$(sed -n 's/^HACK_AGENT=//p' "$top/.hack-env"); human=$(sed -n 's/^HACK_HUMAN=//p' "$top/.hack-env")
    task=$(sed -n 's/^HACK_TASK=//p' "$top/.hack-env")
    write_env "$top" "$agent" "$human" "$task"
    say "SESSION: $(sed -n 's/^HACK_SESSION=//p' "$top/.hack-env")"; exit 0;;
  rm)
    id=${1:-}; printf '%s' "$id" | grep -Eq '^HACK-[0-9]{3,}$' || die "Uso: wt rm HACK-NNN"
    root=$(main_root); [ -n "$root" ] || die "No es un repositorio Git."
    path=$(wt_path "$root" "$id")
    git -C "$root" worktree remove "$path" || die "No se quitó $path (cambios sin commit). Revísalo; nunca uses --force sobre trabajo ajeno."
    say "WT_REMOVED: $path (rama conservada)"; exit 0;;
  new) ;;
  *) usage >&2; exit 2;;
esac

id=${1:-}; [ "$#" -eq 0 ] || shift
printf '%s' "$id" | grep -Eq '^HACK-[0-9]{3,}$' || die "Uso: wt new HACK-NNN [--agent NOMBRE] [--human NOMBRE] [--next TEXTO]"
agent=${HACK_AGENT:-} human=${HACK_HUMAN:-} next_text=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --agent) [ "$#" -gt 1 ] || die "--agent requiere valor"; agent=$2; shift 2;;
    --human) [ "$#" -gt 1 ] || die "--human requiere valor"; human=$2; shift 2;;
    --next) [ "$#" -gt 1 ] || die "--next requiere valor"; next_text=$2; shift 2;;
    *) die "Opción desconocida: $1";;
  esac
done
[ -n "$agent" ] || die "Define --agent NOMBRE o HACK_AGENT (único y estable por agente, p. ej. ana-1)."
[ -n "$human" ] || human=$(git config user.name 2>/dev/null | tr -c 'A-Za-z0-9_.-\n' '-' | tr -s '-' | tr -d '\n')
clean_id "$agent" || die "--agent: sólo letras, números, punto, guion o guion bajo."
clean_id "$human" || die "--human: sólo letras, números, punto, guion o guion bajo."

root=$(main_root); [ -n "$root" ] || die "No es un repositorio Git."
lower=$(printf '%s' "$id" | tr 'A-Z' 'a-z')
branch="feat/$lower"
path=$(wt_path "$root" "$id")
[ ! -e "$path" ] || die "Ya existe $path. Si es tuyo: cd \"$path\". Si es ajeno: no lo toques."
git -C "$root" show-ref --verify --quiet "refs/heads/$branch" && die "La rama $branch ya existe localmente; revisa hack status --task $id --summary."

# Sólo escribe .git/config si hace falta: varios agentes de la misma máquina arrancan a la vez.
[ "$(git -C "$root" config --get core.hooksPath)" = .githooks ] || git -C "$root" config core.hooksPath .githooks
git -C "$root" fetch -q "$REMOTE" "$BASE" || die "No se pudo hacer fetch de $REMOTE/$BASE."
mkdir -p "$(dirname "$path")"
# --no-track: sin upstream no se escribe .git/config (evita el lock entre arranques simultáneos).
added=no
for attempt in 1 2 3 4 5; do
  if git -C "$root" worktree add -q --no-track -b "$branch" "$path" "$REMOTE/$BASE" 2> "${TMPDIR:-/tmp}/wt-add.$$"; then added=yes; break; fi
  # Un intento fallido puede dejar la rama creada sin worktree: se reutiliza sólo si sigue en la base.
  if [ ! -e "$path" ] && git -C "$root" show-ref --verify --quiet "refs/heads/$branch" &&
     [ -z "$(git -C "$root" rev-list "$REMOTE/$BASE..$branch" 2>/dev/null)" ]; then
    git -C "$root" worktree add -q "$path" "$branch" 2>> "${TMPDIR:-/tmp}/wt-add.$$" && { added=yes; break; }
  fi
  sleep "$attempt"
done
[ "$added" = yes ] || { cat "${TMPDIR:-/tmp}/wt-add.$$" >&2; rm -f "${TMPDIR:-/tmp}/wt-add.$$"; die "No se pudo crear el worktree."; }
rm -f "${TMPDIR:-/tmp}/wt-add.$$"
write_env "$path" "$agent" "$human" "$id"

set -- claim "$id" --branch "$branch" --worktree "$path"
[ -z "$next_text" ] || set -- "$@" --next "$next_text"
code=0
(cd "$path" && bash scripts/hack "$@") || code=$?
if [ "$code" -ne 0 ]; then
  # Sólo deshacemos lo que este comando creó y que aún no tiene commits propios.
  if [ -z "$(git -C "$root" rev-list "$REMOTE/$BASE..$branch" 2>/dev/null)" ]; then
    rm -f "$path/.hack-env" "$path/.claude/settings.local.json"
    git -C "$root" worktree remove "$path" >/dev/null 2>&1 && git -C "$root" branch -D "$branch" >/dev/null 2>&1
  fi
  say "WT_CLAIM_FAILED ($code): elige otra tarea con bash scripts/hack next." >&2
  exit "$code"
fi
(cd "$path" && bash scripts/hack inbox --task "$id" 2>/dev/null | tail -n 20)
say "WT_READY: $id · rama $branch · worktree $path"
say "Siguiente: cd \"$path\" y abre ahí tu agente (claude / cursor / codex)."
